# Copy this file to .env.local and adjust the values.
# Only variables prefixed with VITE_ are exposed to browser code.
# Never put secrets (API keys, admin tokens, passwords) in VITE_ variables:
# everything here is bundled into public JavaScript.

# Base URL for the product API (DummyJSON during learning, Laravel later).
VITE_API_BASE_URL=https://dummyjson.com

# Which backend adapter to use: "dummyjson" (default) or "laravel".
# For Laravel, also point VITE_API_BASE_URL at it, e.g. http://localhost:8000
VITE_API_PROVIDER=dummyjson

# Show the /learn component lab in production builds (it's always on in `npm run dev`).
VITE_SHOW_LEARNING_LAB=false

# Where customer and admin ACCOUNTS live: "dummyjson" (default: DummyJSON's demo
# users, nothing is saved) or "laravel" (BuyNest's API in ../backend: real
# sign-up with an emailed code, password reset, separate admin accounts).
# Independent of VITE_API_PROVIDER, which picks the product catalog source.
VITE_ACCOUNTS_BACKEND=dummyjson

# Server-side only (no VITE_ prefix: never bundled into browser code).
# Read by the sign-in service (server/) when VITE_ACCOUNTS_BACKEND=laravel.
BUYNEST_LARAVEL_URL=http://127.0.0.1:8000
# Must equal BFF_SHARED_KEY in ../backend/.env (lets the API rate-limit per visitor).
BUYNEST_BFF_KEY=
