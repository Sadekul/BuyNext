{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm --prefix ../admin install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/admin", "destination": "/admin/", "permanent": false }],
  "rewrites": [
    { "source": "/media/:path*", "destination": "/api/media/:path*" },
    { "source": "/sitemap.xml", "destination": "/api/seo/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/api/seo/robots.txt" },
    { "source": "/admin/((?!assets/).*)", "destination": "/admin/index.html" },
    { "source": "/((?!api/|admin/|media/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(admin/)?assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
