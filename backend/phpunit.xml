<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="buynest_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Production rate limits, whatever this machine's .env relaxes for browser tests -->
        <env name="BUYNEST_AUTH_PER_MINUTE" value="30"/>
        <env name="BUYNEST_AUTH_PER_EMAIL_PER_MINUTE" value="10"/>
        <env name="BUYNEST_ORDERS_PER_MINUTE" value="10"/>
        <env name="BUYNEST_REVIEWS_PER_HOUR" value="10"/>
        <env name="BUYNEST_API_PER_MINUTE" value="240"/>
        <env name="BUYNEST_REQUIRE_BFF_KEY" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Stripe off unless a test turns it on (tests fake Stripe with Http::fake, never the real API) -->
        <env name="STRIPE_SECRET_KEY" value=""/>
        <env name="STRIPE_WEBHOOK_SECRET" value=""/>
        <!-- Phase 18: couriers "not set up" unless a test turns one on (tests fake them with Http::fake) -->
        <env name="STEADFAST_API_KEY" value=""/>
        <env name="STEADFAST_SECRET_KEY" value=""/>
        <env name="STEADFAST_API_URL" value=""/>
        <env name="STEADFAST_WEBHOOK_TOKEN" value=""/>
        <env name="PATHAO_CLIENT_ID" value=""/>
        <env name="PATHAO_CLIENT_SECRET" value=""/>
        <env name="PATHAO_USERNAME" value=""/>
        <env name="PATHAO_PASSWORD" value=""/>
        <env name="PATHAO_STORE_ID" value=""/>
        <env name="PATHAO_API_URL" value=""/>
        <env name="PATHAO_WEBHOOK_SECRET" value=""/>
        <!-- Phase 9 (part B): never send test errors to Sentry; backups go to a faked local disk -->
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="BACKUP_DISK" value="local"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
