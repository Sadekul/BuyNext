APP_NAME=BuyNest
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=buynest
DB_USERNAME=buynest
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@buynest.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# BuyNest
# Local test inbox at /dev/mailbox (APP_ENV=local only). Must be false in production.
DEV_MAILBOX=true
# Shared with the storefront sign-in service (frontend BUYNEST_BFF_KEY). Generate: openssl rand -hex 32
BFF_SHARED_KEY=
BUYNEST_AUTH_PER_MINUTE=30
BUYNEST_AUTH_PER_EMAIL_PER_MINUTE=10
BUYNEST_ORDERS_PER_MINUTE=10
BUYNEST_REVIEWS_PER_HOUR=10
BUYNEST_API_PER_MINUTE=240
# Production: only the storefront (with BFF_SHARED_KEY) may call the API.
BUYNEST_REQUIRE_BFF_KEY=false

# Phase 8: card payments through Stripe Checkout (test mode: sk_test_..., whsec_... from `stripe listen`).
# Empty STRIPE_SECRET_KEY = Stripe off: card orders wait for staff to invoice them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_CHECKOUT_MINUTES=30

# Phase 10 (part B): PayPal (Orders API v2, redirect approval). Empty id/secret = PayPal off:
# PayPal orders wait for staff to invoice them. PAYPAL_MODE: sandbox or live. PAYPAL_WEBHOOK_ID:
# the id of the webhook registered in the PayPal developer dashboard (needed to verify events).
# PAYPAL_API_URL is only for local tests against a stand-in (default: PayPal's sandbox or live API).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_API_URL=

# Phase 9 (part B): error alerts. Empty = nothing is sent to Sentry.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
BUYNEST_CLIENT_ERRORS_PER_MINUTE=10
BUYNEST_STOCK_ALERTS_PER_MINUTE=10
BUYNEST_STOCK_ALERTS_PER_EMAIL_PER_HOUR=5
# Phase 9 (part B): database backups (php artisan buynest:backup). local = storage/app/backups, s3 = BACKUP_S3_* bucket.
BACKUP_DISK=local
BACKUP_KEEP_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
