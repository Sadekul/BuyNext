# Keep the image small and free of local secrets and local data.
.git
.env
.env.*
!.env.example
.editorconfig
.phpunit.result.cache
.phpunit.cache
.idea
.vscode
.cursor
.codex
.zed
*.log
Dockerfile
.dockerignore
docker/railway

# Installed inside the image instead.
vendor
node_modules

# Generated on this computer (with dev packages such as Pail): copying them
# would break the production boot. The image builds its own.
bootstrap/cache/*.php

# Local data: uploaded photos, logs, sessions, compiled views, the SQLite file.
storage/app/public/*
!storage/app/public/.gitignore
storage/app/private/*
!storage/app/private/.gitignore
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*
storage/pail
storage/*.key
database/*.sqlite
public/storage
public/hot
public/build

# Not needed to run the API.
tests
phpunit.xml
